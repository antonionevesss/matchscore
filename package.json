{
  "name": "matchday-control",
  "version": "1.9.0",
  "private": false,
  "type": "module",
  "description": "Standalone, club-agnostic scoreboard controller for Windows and OBS over a local network",
  "keywords": ["scoreboard", "matchday", "obs", "football", "windows", "bun"],
  "license": "MIT",
  "scripts": {
    "dev": "bun run src/server.ts",
    "start": "bun run src/server.ts",
    "test": "bun test",
    "build": "bun run scripts/build.ts",
    "fonts": "bun run scripts/embed-fonts.ts",
    "typecheck": "bunx tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "latest"
  }
}
