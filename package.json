{
  "name": "matchday-control",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "description": "Standalone Matchday Control - single exe serving the stadium scoreboard over LAN",
  "scripts": {
    "dev": "bun run src/server.ts",
